{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EscalaPro CLT",
  "version": "2.0.0",
  "identifier": "br.com.escalapro.clt",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EscalaPro CLT — Gestão de Escalas e Conformidade Trabalhista",
        "width": 1366,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://*.firebaseio.com https://*.firebasedatabase.app;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": "pt-BR"
      },
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}

